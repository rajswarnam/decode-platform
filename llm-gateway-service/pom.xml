<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.3</version>
        <relativePath/>
    </parent>
    <groupId>com.decode</groupId>
    <artifactId>llm-gateway-service</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>llm-gateway-service</name>
    <description>Enterprise LLM Gateway with Governance</description>
    <properties>
        <java.version>17</java.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <exclusions>
                <!-- Exclude Spring AI Azure OpenAI if pulled in transitively -->
                <exclusion>
                    <groupId>org.springframework.ai</groupId>
                    <artifactId>spring-ai-starter-model-azure-openai</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.springframework.ai</groupId>
                    <artifactId>spring-ai-azure-openai-spring-boot-starter</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Removed: spring-ai-starter-model-azure-openai
             We don't use Spring AI's Azure OpenAI client.
             We use InternalLlmClientService (RestTemplate) -> Internal LLM Gateway instead.
        -->
        <dependency>
            <groupId>com.knuddels</groupId>
            <artifactId>jtokkit</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
    <!-- Removed: Spring AI BOM - no longer using Spring AI dependencies -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <distributionManagement>
        <repository>
            <id>central</id>
            <name>transaction-orchestration-svc-maven-release-local</name>
            <url>https://artifactory.us.bank-dns.com:443/artifactory/branch-technology-maven-virtual</url>
        </repository>
        <snapshotRepository>
            <id>snapshots</id>
            <name>transaction-orchestration-svc-maven-snapshot-local</name>
            <url>https://artifactory.us.bank-dns.com:443/artifactory/branch-technology-maven-virtual</url>
        </snapshotRepository>
    </distributionManagement>
    <!-- Removed Spring milestone repository to avoid TLS issues; GA versions resolve from Maven Central -->
</project>