# EditorConfig for Decode.AI - Multi-stack Enterprise Project
root = true

[*]
# Use UTF-8 for all files (Ensures cross-platform character parity)
charset = utf-8
# Use Unix-style line endings (Prevents Vector/Embedding Drift)
end_of_line = lf
# Insert a new line at the end of every file (Standard for POSIX/Alpine)
insert_final_newline = true
# Remove any trailing whitespace on save
trim_trailing_whitespace = true
# Default indentation (can be overridden per language below)
indent_style = space
indent_size = 4

[*.{java,py,c,cpp,h,cbl,cpy}]
# Backend & Legacy: Strict 4-space indentation
indent_style = space
indent_size = 4

[*.{js,jsx,ts,tsx,css,scss,html,json}]
# Web Frontend: Standard 2-space indentation
indent_style = space
indent_size = 2

[*.{sh,ps1,yaml,yml,sql}]
# Infrastructure & Scripts: 2-space indentation
indent_style = space
indent_size = 2

[Makefile]
# Makefiles MUST use real tabs
indent_style = tab